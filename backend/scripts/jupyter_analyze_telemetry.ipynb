"    ax1.set_ylabel(r'Point Count $N$')\n",
"    ax1.grid(True, linestyle='--', alpha=0.5)\n",
"    ax1.legend(loc='upper left', frameon=False)\n",
"    ax1.set_title(r'\textbf{A} Spatial Mesh Density Trajectory', loc='left')\n",
"    \n",
"    # Panel B: High-Frequency Sampling Jitter\n",
"    t_diff = telemetry['time_elapsed'][1:]\n",
"    ax2.scatter(t_diff, jitter * 1e3, color='#c0392b', s=8, alpha=0.7, label=r'Sampling Jitter $\Delta t - 200\text{ms}$')\n",
"    ax2.axhline(0, color='black', linestyle=':', linewidth=0.8)\n",
"    ax2.set_xlabel(r'Elapsed Time $t$ (seconds)')\n",
"    ax2.set_ylabel(r'Jitter $\delta t$ (ms)')\n",
"    ax2.grid(True, linestyle='--', alpha=0.5)\n",
"    ax2.legend(loc='upper right', frameon=False)\n",
"    ax2.set_title(r'\textbf{B} 5 Hz Temporal Acquisition Jitter', loc='left')\n",
"    \n",
"    plt.tight_layout()\n",
"    output_fig_path = 'telemetry_aps_publication_fig.pdf'\n",
