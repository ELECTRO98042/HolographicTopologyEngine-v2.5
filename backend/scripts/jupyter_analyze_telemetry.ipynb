"    'figure.dpi': 300,\n",
"    'savefig.dpi': 300,\n",
"    'savefig.bbox': 'tight',\n",
"    'axes.linewidth': 0.8,\n",
"    'grid.linewidth': 0.5,\n",
"    'lines.linewidth': 1.2\n",
"})\n",
"\n",
"print(f"JAX Backend Device: {jax.devices()[0]}")"
]
},
{
"cell_type": "markdown",
"metadata": {},
"source": [
"## 1. Zero-Copy Telemetry Ingestion & JAX Array Conversion"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"outputs": [],
"source": [
"def load_telemetry_file(filepath: str):\n",
"    """Reads a JSON telemetry audit file and returns JAX array dictionary."""\n",
"    with open(filepath, 'r') as f:\n",
"        data = json.load(f)\n",
"    \n",
"    df = pd.DataFrame(data)\n",
"    \n",
"    # Convert data directly into JAX arrays\n",
"    steps = jnp.array(df['step'].values, dtype=jnp.int32)\n",
"    time_elapsed = jnp.array(df['timeElapsed'].values, dtype=jnp.float32)\n",
"    num_points = jnp.array(df['numPoints'].values, dtype=jnp.float32)\n",
"    logged_at = jnp.array(df['loggedAt'].values, dtype=jnp.float64)\n",
"    \n",
"    return {\n",
"        "step": steps,\n",
"        "time_elapsed": time_elapsed,\n",
"        "num_points": num_points,\n",
"        "logged_at": logged_at,\n",
"        "raw_df": df\n",
"    }\n",
"\n",
"# Search for latest exported audit log or load specified file\n",
"list_of_files = glob.glob('./telemetry_audit_.json') + glob.glob('../telemetry_audit_.json')\n",
"if list_of_files:\n",
"    latest_file = max(list_of_files, key=os.path.getctime)\n",
"    print(f"Loading telemetry file: {latest_file}")\n",
"    telemetry = load_telemetry_file(latest_file)\n",
"else:\n",
"    print("No audit file found in current path. Please supply path manually.")"
]
},
{
"cell_type": "markdown",
"metadata": {},
"source": [
"## 2. JAX Topological Invariant & Rate Estimators"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"outputs": [],
"source": [
"@jax.jit\n",
"def compute_topological_growth_rate(time_array, points_array):\n",
"    """Uses JAX gradient to compute point scaling rate (dN/dt) and finite differences."""\n",
"    dt = jnp.gradient(time_array)\n",
"    dn = jnp.gradient(points_array)\n",
"    growth_rate = dn / jnp.maximum(dt, 1e-6)\n",
"    return growth_rate\n",
"\n",
"@jax.jit\n",
"def compute_jitter_spectrum(time_array):\n",
"    """Calculates frame interval jitter delta_t relative to expected 200ms sampling."""\n",
"    deltas = jnp.diff(time_array)\n",
"    expected_dt = 0.200 # 5Hz sampling rate\n",
"    jitter = deltas - expected_dt\n",
"    mean_jitter = jnp.mean(jnp.abs(jitter))\n",
"    std_jitter = jnp.std(jitter)\n",
"    return deltas, jitter, mean_jitter, std_jitter\n",
"\n",
"if 'telemetry' in locals():\n",
"    growth_rate = compute_topological_growth_rate(telemetry['time_elapsed'], telemetry['num_points'])\n",
"    deltas, jitter, mean_j, std_j = compute_jitter_spectrum(telemetry['time_elapsed'])\n",
"    \n",
"    print(f"Mean Sampling Jitter: {mean_j * 1e3:.3f} ms")\n",
"    print(f"Jitter Std Dev: {std_j * 1e3:.3f} ms")\n",
"    print(f"Average Scaling Rate (dN/dt): {jnp.mean(growth_rate):.2f} pts/sec")"
]
},
